{
  "schemaVersion": 1,
  "site": "chatgpt",
  "revision": 2,
  "version": "2026.11.22-1",
  "minExtVersion": "0.1.0",
  "verified": true,
  "notes": "VERIFIED 2026-11-22 against the real signed-in chatgpt.com (Chrome for Testing 159, desktop layout, new-chat page, existing and new threads). Verified: composer, attach (hidden file inputs + Remove chip), send button (type=submit aria-label Send; only exists once the composer has content), stop button (aria-label Stop; sending then stopping mid-stream flips the turn to cancelled), assistant message (h4[data-conversation-role=assistant] parent; no data-message-author-role or conversation-turn testids any more), reply text ([data-markdown-copy=contents], grows while streaming), code blocks, completion (Stop gone; data-talvt-turn-state on the turn goes in_progress then complete or cancelled). Not extractable with the current interpreter: file downloads are span[role=link] widgets plus a 'Download file' button, with no href; generated images are blob: URLs. Old selectors are kept as fallbacks.",
  "integrity": {
    "alg": "sha256",
    "hash": "cdd128d6003fc5a8d2c80a6491774696c14a8478138a8e38b6e8d4ad817c8bca",
    "sig": "",
    "keyId": ""
  },
  "match": {
    "hosts": [
      "chatgpt.com"
    ]
  },
  "flow": [
    "text",
    "attach",
    "send"
  ],
  "steps": {
    "loggedOut": {
      "selectors": [
        "[data-testid='login-button']",
        {
          "css": "a[href*='/auth/login'], button",
          "textMatches": "^\\s*(log in|sign up)"
        }
      ]
    },
    "prompt": {
      "selectors": [
        "form div.ProseMirror[contenteditable='true'][role='textbox']",
        "div.ProseMirror[contenteditable='true'][role='textbox']",
        "#prompt-textarea",
        "div.ProseMirror[contenteditable='true']",
        "div[contenteditable='true'][role='textbox']",
        "textarea[data-id='root']",
        "form textarea"
      ],
      "timeoutMs": 15000,
      "setText": [
        "execCommand",
        "paste",
        "textContent"
      ],
      "clearFirst": true
    },
    "attach": {
      "strategies": [
        {
          "type": "fileInput",
          "selectors": [
            "form input[type='file']:not([accept])",
            "input[type='file'][multiple]",
            "input[type='file'][accept*='image']",
            "input[type='file']"
          ],
          "waitMs": 2000
        },
        {
          "type": "paste"
        },
        {
          "type": "drop"
        }
      ],
      "confirm": {
        "selectors": [
          "form button[aria-label^='Remove ']",
          "[data-testid='attachment-thumbnail']",
          "[data-testid*='attachment']",
          "form img[alt]:not([alt=''])",
          "form [aria-label*='Remove file' i]",
          "form button[aria-label*='Remove' i]"
        ],
        "timeoutMs": 20000
      }
    },
    "send": {
      "selectors": [
        "form button[type='submit'][aria-label='Send']",
        "button[type='submit'][aria-label='Send']",
        "button[data-testid='send-button']",
        "#composer-submit-button",
        "button[aria-label='Send prompt']",
        "button[aria-label='Send message']",
        "button[aria-label*='Send' i]"
      ],
      "timeoutMs": 60000,
      "requireEnabled": true,
      "fallbackKey": "Enter"
    },
    "stop": {
      "selectors": [
        "button[aria-label='Stop']",
        "button[data-testid='stop-button']",
        "button[aria-label='Stop streaming']",
        "button[aria-label*='Stop' i]"
      ]
    },
    "assistantMessage": {
      "selectors": [
        "div:has(> h4[data-conversation-role='assistant'])",
        "[data-message-author-role='assistant']",
        "article[data-testid^='conversation-turn'] [data-message-author-role='assistant']"
      ],
      "textSelectors": [
        "[data-markdown-copy='contents']",
        "[data-response-body]",
        ".markdown",
        "[class*='markdown']"
      ],
      "pick": "last"
    },
    "files": {
      "allowedHosts": [
        "files.oaiusercontent.com",
        "oaiusercontent.com",
        "chatgpt.com"
      ],
      "links": [
        {
          "selectors": [
            "a[href^='sandbox:']",
            "a[href*='/backend-api/files/']",
            "a[download]"
          ],
          "kind": "file"
        },
        {
          "selectors": [
            ".markdown a[href^='http']"
          ],
          "kind": "link"
        }
      ],
      "images": [
        {
          "selectors": [
            "img[src*='oaiusercontent.com']",
            "img[alt^='Generated image' i]"
          ]
        }
      ]
    },
    "errors": [
      {
        "selectors": [
          {
            "css": "[role='alert']",
            "textMatches": "too many requests|rate limit|limit reached"
          }
        ],
        "code": "rate_limited"
      },
      {
        "selectors": [
          {
            "css": "[role='alert'], .text-token-text-error",
            "textMatches": "something went wrong|network error"
          }
        ],
        "code": "chat_error"
      }
    ]
  },
  "stream": {
    "startTimeoutMs": 90000,
    "maxDurationMs": 900000,
    "emitMinIntervalMs": 120,
    "done": {
      "all": [
        {
          "type": "newMessage"
        },
        {
          "type": "absent",
          "step": "stop"
        },
        {
          "type": "textStable",
          "ms": 1500
        }
      ]
    }
  }
}
