{
  "schemaVersion": 1,
  "site": "claude",
  "revision": 1,
  "version": "2026.11.25-1",
  "minExtVersion": "0.1.13",
  "verified": false,
  "notes": "rev 1 (v0.1.13). UNVERIFIED against a live signed-in claude.ai (claude.ai answers 403 to unauthenticated fetches, so nothing could be read live). Built from public knowledge of claude.ai's web DOM: ProseMirror prompt (aria-label 'Write your prompt to Claude'), hidden input[data-testid=file-upload], 'Send message' / 'Stop response' buttons, user turns [data-testid=user-message], assistant turns .font-claude-response inside [data-is-streaming], code blocks in pre, file cards for files Claude creates. Every selector can be overridden by publishing a new revision of this file.",
  "match": {
    "hosts": [
      "claude.ai"
    ]
  },
  "guard": {
    "neverClick": [
      "upgrade|subscribe|get (pro|max)|try (pro|max)|\\bplans?\\b",
      "model (select|picker)|\\b(opus|sonnet|haiku)\\b",
      "extended thinking|research mode|\\bstyle\\b",
      "incognito|\\bprojects?\\b",
      "\\b(delete|rename|share|archive|pin|export|report|feedback)\\b",
      "settings|sign out|log out|logout"
    ]
  },
  "flow": [
    "newChat",
    "text",
    "attach",
    "send"
  ],
  "steps": {
    "loggedOut": {
      "strict": false,
      "selectors": [
        "a[href^='/login']",
        "form[action*='/login']",
        {
          "css": "a, button",
          "textMatches": "^\\s*(log in|sign in|continue with google|continue with email)\\s*$"
        }
      ]
    },
    "newChat": {
      "homePath": "^/new/?$",
      "timeoutMs": 10000,
      "selectors": [
        "a[href='/new'][aria-label='New chat' i]",
        "a[aria-label='New chat' i]",
        "a[href='/new']",
        "button[aria-label='New chat' i]",
        {
          "css": "a, button",
          "textMatches": "^\\s*new chat\\s*$"
        }
      ]
    },
    "prompt": {
      "selectors": [
        "div.ProseMirror[contenteditable='true'][aria-label*='prompt' i]",
        "fieldset div.ProseMirror[contenteditable='true']",
        "div.ProseMirror[contenteditable='true']",
        "[data-testid='chat-input'] [contenteditable='true']",
        "[data-testid='chat-input']",
        "div[contenteditable='true'][role='textbox']",
        "fieldset textarea"
      ],
      "timeoutMs": 30000,
      "setText": [
        "execCommand",
        "paste",
        "textContent"
      ],
      "clearFirst": true
    },
    "attach": {
      "strategies": [
        {
          "type": "fileInput",
          "selectors": [
            "input[data-testid='file-upload']",
            "fieldset input[type='file']",
            "input[type='file'][multiple]",
            "input[type='file']"
          ],
          "waitMs": 300,
          "confirmMs": 10000
        },
        {
          "type": "hookedChooser",
          "openSelectors": [
            "button[data-testid='input-menu-plus']",
            "button[aria-label^='Add files' i]",
            "button[aria-label*='attach' i]",
            "button[aria-label*='upload' i]"
          ],
          "itemSelectors": [
            "[role='menuitem'][data-testid*='upload' i]",
            {
              "css": "[role='menuitem'], button",
              "textMatches": "^\\s*(upload (a )?files?|add files( or photos)?|add from (computer|device)|files?)\\s*$"
            }
          ],
          "waitMs": 4000,
          "confirmMs": 12000
        },
        {
          "type": "drop",
          "selectors": [
            "fieldset",
            "[data-testid='chat-input']",
            "div.ProseMirror[contenteditable='true']"
          ],
          "confirmMs": 8000
        },
        {
          "type": "paste",
          "confirmMs": 6000
        }
      ],
      "confirm": {
        "selectors": [
          "[data-testid='file-thumbnail']",
          "[data-testid*='file-thumbnail' i]",
          "[data-testid*='attachment' i]",
          "fieldset button[aria-label^='Remove' i]",
          "fieldset img[src^='blob:']",
          "fieldset [class*='thumbnail' i]",
          "[class*='attachment' i] img"
        ],
        "timeoutMs": 20000
      },
      "inlineFallback": {
        "maxBytes": 120000,
        "maxFileBytes": 60000
      }
    },
    "send": {
      "selectors": [
        "button[aria-label='Send message']",
        "button[aria-label='Send Message']",
        "fieldset button[type='submit']",
        "button[aria-label^='Send' i]"
      ],
      "timeoutMs": 90000,
      "requireEnabled": true,
      "fallbackKey": "Enter"
    },
    "stop": {
      "selectors": [
        "button[aria-label='Stop response']:not([hidden])",
        "button[aria-label='Stop Response']:not([hidden])",
        "button[data-testid*='stop' i]:not([hidden])",
        "button[aria-label^='Stop' i]:not([hidden])",
        "div[data-is-streaming='true']"
      ]
    },
    "assistantMessage": {
      "selectors": [
        "div[data-is-streaming] .font-claude-response",
        "div.font-claude-response",
        "div.font-claude-message",
        "div[data-is-streaming]"
      ],
      "textSelectors": [
        ".standard-markdown",
        ".progressive-markdown",
        ".font-claude-response",
        ".font-claude-message"
      ],
      "pick": "last"
    },
    "blocks": {
      "ignoreSelectors": [
        "button",
        "svg",
        "[data-testid*='thinking' i]",
        "[class*='thinking' i]",
        "[data-testid*='action-bar' i]"
      ],
      "langSelectors": [
        "pre > div:first-child > div:first-child",
        "pre [class*='lang' i]",
        "pre code[class*='language-']"
      ],
      "markdownText": true
    },
    "files": {
      "allowedHosts": [
        "claude.ai",
        "claudeusercontent.com"
      ],
      "links": [
        {
          "selectors": [
            "a[download]"
          ],
          "kind": "file"
        },
        {
          "selectors": [
            ".font-claude-response a[href^='http']"
          ],
          "kind": "link"
        }
      ],
      "images": [
        {
          "selectors": [
            ".font-claude-response img[src^='https://claude.ai/']",
            ".font-claude-response img[src^='blob:']"
          ]
        }
      ],
      "generated": {
        "useHook": true,
        "selectors": [
          "[data-testid*='file-card' i]",
          "[data-testid*='artifact' i]",
          "[data-testid*='file-thumbnail' i]",
          ".font-claude-response [class*='artifact' i]",
          "[class*='file-card' i]",
          "a[download]",
          "a[href^='blob:']",
          "a[href*='/files/'][href*='/contents']"
        ],
        "textNames": true,
        "climb": 4,
        "downloadSelectors": [
          "a[download]",
          "button[aria-label*='download' i]",
          "a[aria-label*='download' i]",
          "[role='button'][aria-label*='download' i]",
          "[data-testid*='download' i]",
          {
            "css": "button, [role='button'], a",
            "textMatches": "^\\s*(download|save)( file| image)?\\s*$"
          }
        ],
        "allowedHosts": [
          "claude.ai",
          "claudeusercontent.com"
        ],
        "tagText": "\\[file-tag:\\s*[^\\]]{1,120}\\]",
        "timeoutMs": 25000,
        "fetchMs": 12000,
        "captureMs": 8000
      }
    },
    "errors": [
      {
        "selectors": [
          {
            "css": "[role='alert'], [role='status'], [role='dialog'], [data-sonner-toast], [data-testid*='toast' i]",
            "textMatches": "(reached|hit) (your|the) (usage |message |daily |free |rate |upload )?limit"
          },
          {
            "css": "[role='alert'], [role='status'], [role='dialog'], [data-sonner-toast], [data-testid*='toast' i]",
            "textMatches": "out of (free )?(messages|queries|uploads)|limit resets|upgrade to (continue|keep)"
          },
          {
            "css": "div.font-claude-response",
            "textMatches": "^\\s*you.{0,3}(ve|have) (reached|hit) (your|the) (usage |message |daily |free )?limit"
          }
        ],
        "code": "usage_limit"
      },
      {
        "selectors": [
          {
            "css": "[role='alert'], [role='status'], [role='dialog'], [data-sonner-toast], [data-testid*='toast' i]",
            "textMatches": "sign in to (upload|continue|use|keep)|log in to (upload|continue)|signed out|session expired"
          }
        ],
        "code": "not_logged_in"
      },
      {
        "selectors": [
          {
            "css": "[role='alert'], [role='status'], [role='dialog'], [data-sonner-toast], [data-testid*='toast' i]",
            "textMatches": "too many requests|rate limit|try again (later|in a (few|moment))"
          }
        ],
        "code": "rate_limited"
      },
      {
        "selectors": [
          {
            "css": "[role='alert'], [role='status'], [role='dialog'], [data-sonner-toast], [data-testid*='toast' i]",
            "textMatches": "something went wrong|network error|couldn.t (upload|send)|failed to upload|upload failed"
          },
          {
            "css": "[role='alert'], [role='status'], [role='dialog'], [data-sonner-toast], [data-testid*='toast' i]",
            "textMatches": "file (type )?(is )?not supported|too large|exceeds? the (size|length)"
          }
        ],
        "code": "chat_error"
      }
    ]
  },
  "stream": {
    "startTimeoutMs": 120000,
    "maxDurationMs": 900000,
    "noReplyGraceMs": 10000,
    "emitMinIntervalMs": 150,
    "done": {
      "all": [
        {
          "type": "newMessage"
        },
        {
          "type": "absent",
          "step": "stop"
        },
        {
          "type": "textStable",
          "ms": 2000
        }
      ]
    }
  },
  "integrity": {
    "alg": "sha256",
    "hash": "fef9bd963c56a4e1c1cb7bd2b3d5cf5f418758c815afa9c55ed9366b07550a49",
    "sig": "",
    "keyId": ""
  }
}
