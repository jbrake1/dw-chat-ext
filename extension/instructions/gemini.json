{
  "schemaVersion": 1,
  "site": "gemini",
  "revision": 5,
  "version": "2026.11.27-5",
  "minExtVersion": "0.1.12",
  "verified": false,
  "notes": "UNVERIFIED against a live signed-in gemini.google.com (built from public knowledge of its web DOM plus owner snapshot s2b34afff, selectors only, and the owner's v0.1.9 retest). rev 2: Upload & tools menu + page hook (content/ai-hook.js), drop and paste fallbacks, growth-based chip confirmation, inlineFallback. rev 3: steps.blocks.markdownText reads the reply as markdown (code blocks as fences, raw HTML runs fenced, whole documents become blocks). Chip and code-block names are still unverified. rev 4 (v0.1.12): steps.files.generated reads files Gemini made with code (download chips under the reply) once the reply is done. Chip markup is unverified against a live reply; needs extension 0.1.12. rev 5 (v0.1.15): broader assistant and stop selectors (response-container, aria-label Gemini response, stop-button / Stop generating) so a reply the older list missed can still be read; the extension also rescans on no_stream and can recover from a chat URL. Every selector can be overridden by publishing a new revision of this file.",
  "match": {
    "hosts": [
      "gemini.google.com"
    ]
  },
  "guard": {
    "neverClick": [
      "upgrade",
      "get app",
      "try (gemini )?(advanced|pro|ultra)",
      "model|mode picker|hydrogen|flash|thinking|deep research",
      "\\b(delete|rename|share|archive|pin|export|report)\\b",
      "settings|activity|sign out|log out"
    ]
  },
  "flow": [
    "newChat",
    "text",
    "attach",
    "send"
  ],
  "steps": {
    "loggedOut": {
      "strict": true,
      "selectors": [
        "a[href*='accounts.google.com/ServiceLogin']",
        "a[href*='accounts.google.com/v3/signin']",
        {
          "css": "a[aria-label], button[aria-label]",
          "textMatches": "^\\s*sign in\\s*$"
        }
      ]
    },
    "newChat": {
      "homePath": "^/(u/\\d+/)?app/?$",
      "timeoutMs": 10000,
      "selectors": [
        "side-nav-action-button[data-test-id='new-chat-button'] a",
        "side-nav-action-button[data-test-id='new-chat-button'] button",
        "[data-test-id='new-chat-button'] a",
        "[data-test-id='new-chat-button'] button",
        "a[aria-label='New chat']",
        "button[aria-label='New chat']",
        {
          "css": "a, button",
          "textMatches": "^\\s*new chat\\s*$"
        }
      ]
    },
    "prompt": {
      "selectors": [
        "rich-textarea div.ql-editor[contenteditable='true']",
        "div.ql-editor[contenteditable='true'][role='textbox']",
        "div.ql-editor[contenteditable='true']",
        "[contenteditable='true'][aria-label*='Gemini' i]",
        "[contenteditable='true'][aria-label*='prompt' i]",
        "input-area-v2 [contenteditable='true']",
        "div[contenteditable='true'][role='textbox']"
      ],
      "timeoutMs": 30000,
      "setText": [
        "execCommand",
        "paste",
        "textContent"
      ],
      "clearFirst": true
    },
    "attach": {
      "strategies": [
        {
          "type": "fileInput",
          "selectors": [
            "uploader input[type='file']",
            "input-area-v2 input[type='file']",
            "input[type='file'][multiple]",
            "input[type='file']"
          ],
          "waitMs": 300,
          "confirmMs": 6000
        },
        {
          "type": "hookedChooser",
          "openSelectors": [
            "button[aria-label='Upload & tools']",
            "button[aria-label*='upload' i][aria-label*='tools' i]",
            "[aria-label='Upload & tools']",
            "button[aria-label='Open upload file menu']",
            "button.upload-card-button",
            "uploader button",
            "button[aria-label*='upload' i]",
            "button[aria-label*='add files' i]"
          ],
          "itemSelectors": [
            "[data-test-id='uploader-images-files-button-advanced'] button:not(.hidden-local-file-image-selector-button)",
            "images-files-uploader[data-test-id='uploader-images-files-button-advanced'] button:not(.hidden-local-file-image-selector-button)",
            "[data-test-id='local-images-files-uploader-button']",
            "button[aria-label^='Upload files' i]",
            "[role='menuitem'][aria-label^='Upload files' i]",
            "[data-test-id='uploader-images-files-button-advanced']",
            {
              "css": "button, [role='menuitem']",
              "textMatches": "^\\s*(upload files|files)\\s*$"
            }
          ],
          "waitMs": 4000,
          "confirmMs": 12000
        },
        {
          "type": "drop",
          "selectors": [
            "[xapfileselectordropzone]",
            "xap-uploader-dropzone",
            "input-area-v2",
            "rich-textarea"
          ],
          "confirmMs": 8000
        },
        {
          "type": "paste",
          "confirmMs": 6000
        }
      ],
      "confirm": {
        "selectors": [
          "uploader-file-preview",
          "uploader-file-preview-container",
          "[data-test-id='file-preview']",
          "[data-test-id='image-preview']",
          "[data-test-id*='file-preview']",
          ".file-preview-container",
          "[class*='file-preview']",
          "[class*='attachment-preview']",
          "input-area-v2 [class*='preview'] img",
          "input-area-v2 button[aria-label^='Remove' i]",
          "input-area-v2 button[aria-label*='remove file' i]",
          "input-area-v2 img[src^='blob:']"
        ],
        "timeoutMs": 12000
      },
      "inlineFallback": {
        "maxBytes": 120000,
        "maxFileBytes": 60000
      }
    },
    "send": {
      "selectors": [
        "button.send-button[aria-label='Send message']",
        "button[aria-label='Send message']",
        ".send-button-container button.send-button:not(.stop)",
        "button[aria-label^='Send' i]"
      ],
      "timeoutMs": 90000,
      "requireEnabled": true,
      "fallbackKey": "Enter"
    },
    "stop": {
      "selectors": [
        "button[aria-label='Stop response']",
        "button.send-button.stop",
        "button[data-test-id='stop-button']",
        "button.stop-button",
        "button[aria-label*='Stop generating' i]",
        "button[aria-label^='Stop' i][aria-label*='respon' i]",
        "button[aria-label^='Stop' i]",
        "button[aria-label*='Stop' i]"
      ]
    },
    "assistantMessage": {
      "selectors": [
        "model-response",
        "[data-test-id='model-response']",
        "div.model-response-text",
        "message-content.model-response-text",
        "response-container",
        ".response-container",
        ".presented-response-container",
        ".response-content",
        ".model-response",
        "[aria-label='Gemini response']",
        "[aria-label*='Gemini response' i]",
        "chat-turn model-response",
        "[data-test-id='conversation-turn'] model-response"
      ],
      "textSelectors": [
        "message-content .markdown",
        ".markdown.markdown-main-panel",
        ".model-response-text .markdown",
        "message-content",
        ".markdown",
        ".response-content",
        ".model-response-text"
      ],
      "pick": "last"
    },
    "blocks": {
      "ignoreSelectors": [
        ".code-block-decoration",
        "code-block .buttons",
        "button",
        "mat-icon",
        "model-thoughts",
        "sources-list"
      ],
      "langSelectors": [
        ".code-block-decoration > span",
        ".code-block-decoration span",
        ".code-block-decoration"
      ],
      "markdownText": true
    },
    "files": {
      "allowedHosts": [
        "lh3.googleusercontent.com",
        "googleusercontent.com"
      ],
      "links": [
        {
          "selectors": [
            "message-content a[download]"
          ],
          "kind": "file"
        },
        {
          "selectors": [
            "message-content .markdown a[href^='http']"
          ],
          "kind": "link"
        }
      ],
      "images": [
        {
          "selectors": [
            "generated-image img[src*='googleusercontent.com']",
            "single-image img[src*='googleusercontent.com']"
          ]
        }
      ],
      "generated": {
        "useHook": true,
        "selectors": [
          "code-execution-file",
          "generated-file",
          "file-download-chip",
          "download-chip",
          "[data-test-id*='generated-file' i]",
          "[data-test-id*='file-chip' i]",
          "[data-test-id*='download' i][data-test-id*='file' i]",
          "[class*='generated-file' i]",
          "[class*='file-chip' i]",
          "[class*='download-chip' i]",
          "message-content a[download]",
          "message-content a[href^='blob:']"
        ],
        "textNames": true,
        "climb": 4,
        "downloadSelectors": [
          "a[download]",
          "button[aria-label*='download' i]",
          "a[aria-label*='download' i]",
          "[role='button'][aria-label*='download' i]",
          "[data-test-id*='download' i]",
          {
            "css": "button, [role='button']",
            "textMatches": "^\\s*(file_)?download(_for_offline)?\\s*$"
          },
          {
            "css": "button, [role='button']",
            "textMatches": "^\\s*(download|save)( file| image)?\\s*$"
          }
        ],
        "allowedHosts": [
          "googleusercontent.com",
          "gemini.google.com",
          "usercontent.google.com"
        ],
        "tagText": "\\[file-tag:\\s*[^\\]]{1,120}\\]",
        "timeoutMs": 25000,
        "fetchMs": 12000,
        "captureMs": 8000
      }
    },
    "errors": [
      {
        "selectors": [
          {
            "css": "snack-bar-container, mat-snack-bar-container, .mat-mdc-snack-bar-container, [role='alert'], [role='dialog']",
            "textMatches": "you.{0,3}ve (reached|hit) (your|the) (usage |daily |upload |file |prompt )?limit"
          },
          {
            "css": "snack-bar-container, mat-snack-bar-container, .mat-mdc-snack-bar-container, [role='alert'], [role='dialog']",
            "textMatches": "limit resets|upload limit|out of (uploads|prompts|data analysis)"
          },
          {
            "css": "model-response message-content",
            "textMatches": "^\\s*you.{0,3}ve (reached|hit) (your|the) (usage |daily |upload |file |prompt )?limit"
          },
          {
            "css": "model-response message-content",
            "textMatches": "^\\s*you.{0,3}re out of"
          }
        ],
        "code": "usage_limit"
      },
      {
        "selectors": [
          {
            "css": "snack-bar-container, mat-snack-bar-container, .mat-mdc-snack-bar-container, [role='alert'], [role='dialog']",
            "textMatches": "sign in to (upload|continue|use|keep)|signed out"
          }
        ],
        "code": "not_logged_in"
      },
      {
        "selectors": [
          {
            "css": "snack-bar-container, mat-snack-bar-container, .mat-mdc-snack-bar-container, [role='alert']",
            "textMatches": "too many requests|rate limit|try again later"
          }
        ],
        "code": "rate_limited"
      },
      {
        "selectors": [
          {
            "css": "snack-bar-container, mat-snack-bar-container, .mat-mdc-snack-bar-container, [role='alert']",
            "textMatches": "something went wrong|network error|couldn.t (upload|send)|failed to upload|file (type )?(is )?not supported|too large"
          }
        ],
        "code": "chat_error"
      }
    ]
  },
  "stream": {
    "startTimeoutMs": 120000,
    "maxDurationMs": 900000,
    "noReplyGraceMs": 10000,
    "emitMinIntervalMs": 150,
    "done": {
      "all": [
        {
          "type": "newMessage"
        },
        {
          "type": "absent",
          "step": "stop"
        },
        {
          "type": "textStable",
          "ms": 2000
        }
      ]
    }
  },
  "integrity": {
    "alg": "sha256",
    "hash": "c4fb62e1364c8fe8237d3f46a22d9afa73782f554c8cfcea24542972f4536084",
    "sig": "",
    "keyId": ""
  }
}
