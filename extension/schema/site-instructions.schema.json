{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://app.dwalliance.com/_dw/ext/schema/site-instructions.v1.json",
  "title": "DW Chat Integration site instructions (schemaVersion 1)",
  "description": "Declarative description of how to drive one chat site's web UI. Data only: the extension never executes anything from this file. Every step lists selectors in priority order (index 0 = primary, later entries = fallbacks).",
  "type": "object",
  "required": ["schemaVersion", "site", "revision", "version", "minExtVersion", "match", "flow", "steps", "stream"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "site": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
    "revision": { "type": "integer", "minimum": 1, "description": "Monotonic. The extension rejects a remote file whose revision is lower than the one it already has." },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z._-]{1,32}$", "description": "Human readable, reported in error reports as instructionsVersion." },
    "minExtVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$" },
    "verified": { "type": "boolean", "description": "false = selectors are best-effort and have not been confirmed against the live site." },
    "notes": { "type": "string", "maxLength": 2000 },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": { "enum": ["sha256", "sha256+ed25519"] },
        "hash": { "type": "string", "pattern": "^([0-9a-f]{64})?$", "description": "sha256 hex of canonical JSON of this document without the integrity field. Empty = placeholder (not checked)." },
        "sig": { "type": "string", "maxLength": 200, "description": "base64url Ed25519 signature over the hash string. Checked when the extension is configured with a public key." },
        "keyId": { "type": "string", "maxLength": 40 }
      }
    },
    "match": {
      "type": "object", "required": ["hosts"], "additionalProperties": false,
      "properties": { "hosts": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z0-9.-]{3,80}$" } } }
    },
    "flow": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "enum": ["newChat", "text", "attach", "send"] }, "description": "Order of the input steps. \"newChat\" (v0.1.6, optional, first) starts an empty conversation before the prompt box is used." },
    "guard": {
      "type": "object", "additionalProperties": false,
      "description": "v0.1.6: safety. The runner never clicks an element whose text or aria-label matches any neverClick regex (case-insensitive).",
      "properties": { "neverClick": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 120 } } }
    },
    "steps": {
      "type": "object",
      "required": ["prompt", "attach", "send", "stop", "assistantMessage"],
      "additionalProperties": false,
      "properties": {
        "loggedOut": {
          "type": "object", "required": ["selectors"], "additionalProperties": false,
          "properties": {
            "selectors": { "$ref": "#/definitions/selectors" },
            "strict": { "type": "boolean", "description": "v0.1.6: true = signed out even when a prompt box is shown (sites that allow anonymous chat but not uploads)." }
          }
        },
        "newChat": {
          "type": "object", "required": ["selectors"], "additionalProperties": false,
          "properties": {
            "selectors": { "$ref": "#/definitions/selectors" },
            "homePath": { "type": "string", "maxLength": 120, "description": "Regex for location.pathname of the empty new-chat page; when it matches and no assistant message is shown, nothing is clicked." },
            "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 60000 }
          }
        },
        "blocks": {
          "type": "object", "additionalProperties": false, "description": "v0.1.6: code-block reading hints (header text to skip, language chip).",
          "properties": { "ignoreSelectors": { "$ref": "#/definitions/selectors" }, "langSelectors": { "$ref": "#/definitions/selectors" }, "markdownText": { "type": "boolean", "description": "v0.1.10: read the reply as markdown (code blocks as fences, raw HTML runs fenced and whole documents turned into blocks)." } }
        },
        "prompt": {
          "type": "object", "required": ["selectors"], "additionalProperties": false,
          "properties": {
            "selectors": { "$ref": "#/definitions/selectors" },
            "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
            "setText": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["execCommand", "paste", "textContent"] } },
            "clearFirst": { "type": "boolean" }
          }
        },
        "attach": {
          "type": "object", "required": ["strategies"], "additionalProperties": false,
          "properties": {
            "strategies": {
              "type": "array", "minItems": 1, "maxItems": 6,
              "items": {
                "type": "object", "required": ["type"], "additionalProperties": false,
                "properties": {
                  "type": { "enum": ["fileInput", "menuFileInput", "hookedChooser", "paste", "drop"] },
                  "selectors": { "$ref": "#/definitions/selectors" },
                  "openSelectors": { "$ref": "#/definitions/selectors" },
                  "itemSelectors": { "$ref": "#/definitions/selectors" },
                  "closeMenu": { "type": "boolean" },
                  "waitMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
                  "confirmMs": { "type": "integer", "minimum": 500, "maximum": 120000, "description": "v0.1.9: how long to wait for the attachment to show after THIS strategy (overrides confirm.timeoutMs)." }
                }
              }
            },
            "confirm": {
              "type": "object", "required": ["selectors"], "additionalProperties": false,
              "properties": { "selectors": { "$ref": "#/definitions/selectors" }, "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 } }
            },
            "inlineFallback": {
              "type": "object", "additionalProperties": false,
              "description": "v0.1.9: when no strategy attaches the files, send the text files inside the message instead (no screenshot) and say so.",
              "properties": { "maxBytes": { "type": "integer", "minimum": 1000, "maximum": 400000 }, "maxFileBytes": { "type": "integer", "minimum": 1000, "maximum": 200000 } }
            }
          }
        },
        "send": {
          "type": "object", "required": ["selectors"], "additionalProperties": false,
          "properties": {
            "selectors": { "$ref": "#/definitions/selectors" },
            "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 180000 },
            "requireEnabled": { "type": "boolean" },
            "fallbackKey": { "enum": ["Enter"] }
          }
        },
        "stop": { "$ref": "#/definitions/selectorStep" },
        "assistantMessage": {
          "type": "object", "required": ["selectors"], "additionalProperties": false,
          "properties": {
            "selectors": { "$ref": "#/definitions/selectors" },
            "textSelectors": { "$ref": "#/definitions/selectors" },
            "pick": { "enum": ["last", "first-new"] }
          }
        },
        "files": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "allowedHosts": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[a-z0-9.-]{3,80}$" } },
            "links": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/fileEntry" } },
            "images": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/fileEntry" } },
            "generated": {
              "type": "object", "additionalProperties": false,
              "description": "v0.1.12: files the AI made, shown as download chips under the reply. Read once the reply is done.",
              "properties": {
                "useHook": { "type": "boolean" },
                "selectors": { "$ref": "#/definitions/selectors" },
                "textNames": { "type": "boolean" },
                "climb": { "type": "integer", "minimum": 0, "maximum": 8 },
                "downloadSelectors": { "$ref": "#/definitions/selectors" },
                "click": { "type": "boolean" },
                "allowedHosts": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[a-z0-9.-]{3,80}$" } },
                "tagText": { "type": "string", "maxLength": 200 },
                "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
                "fetchMs": { "type": "integer", "minimum": 500, "maximum": 30000 },
                "captureMs": { "type": "integer", "minimum": 500, "maximum": 15000 }
              }
            }
          }
        },
        "errors": {
          "type": "array", "maxItems": 10,
          "items": {
            "type": "object", "required": ["selectors", "code"], "additionalProperties": false,
            "properties": { "selectors": { "$ref": "#/definitions/selectors" }, "code": { "type": "string", "pattern": "^[a-z_]{1,40}$" } }
          }
        }
      }
    },
    "stream": {
      "type": "object", "required": ["done"], "additionalProperties": false,
      "properties": {
        "startTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "maxDurationMs": { "type": "integer", "minimum": 5000, "maximum": 3600000 },
        "noReplyGraceMs": { "type": "integer", "minimum": 500, "maximum": 120000, "description": "After the stop button was seen and went away without any assistant message being found, wait this long, then fail with no_reply (stale reply selector)." },
        "emitMinIntervalMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "done": {
          "type": "object", "required": ["all"], "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {
                "anyOf": [
                  { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "newMessage" } } },
                  { "type": "object", "required": ["type", "step"], "additionalProperties": false, "properties": { "type": { "enum": ["present", "absent"] }, "step": { "enum": ["stop"] } } },
                  { "type": "object", "required": ["type", "ms"], "additionalProperties": false, "properties": { "type": { "const": "textStable" }, "ms": { "type": "integer", "minimum": 0, "maximum": 60000 }, "allowEmpty": { "type": "boolean" } } },
                  { "type": "object", "required": ["type", "ms"], "additionalProperties": false, "properties": { "type": { "const": "minElapsedMs" }, "ms": { "type": "integer", "minimum": 0, "maximum": 600000 } } }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "selector": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 300 },
        {
          "type": "object", "required": ["css"], "additionalProperties": false,
          "properties": {
            "css": { "type": "string", "minLength": 1, "maxLength": 300 },
            "textMatches": { "type": "string", "maxLength": 120, "description": "Case-insensitive regex tested against the element's text plus aria-label." },
            "visible": { "type": "boolean" }
          }
        }
      ]
    },
    "selectors": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/definitions/selector" } },
    "selectorStep": {
      "type": "object", "required": ["selectors"], "additionalProperties": false,
      "properties": { "selectors": { "$ref": "#/definitions/selectors" } }
    },
    "fileEntry": {
      "type": "object", "required": ["selectors"], "additionalProperties": false,
      "description": "Unlike other steps, ALL selectors here are collected (union), not first-match.",
      "properties": { "selectors": { "$ref": "#/definitions/selectors" }, "kind": { "enum": ["file", "link"] } }
    }
  }
}
