{
  "manifest_version": 3,
  "name": "DW Chat Integration",
  "version": "0.1.16",
  "minimum_chrome_version": "120",
  "description": "Sends a DW Alliance 'Suggest an edit' request (screenshot, note and the page's source files) to ChatGPT, Gemini, Grok or Claude in a tab, and shows the streamed reply next to the editor. Active only for signed-in site editors.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://claude.ai/*",
    "https://app.dwalliance.com/*",
    "https://mingapothecary.com/*",
    "https://www.mingapothecary.com/*",
    "https://dwalliance.com/*",
    "https://www.dwalliance.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "action": {
    "default_title": "DW Chat Integration (off on this page)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/grey-16.png",
      "32": "icons/grey-32.png",
      "48": "icons/grey-48.png",
      "128": "icons/grey-128.png"
    }
  },
  "icons": {
    "16": "icons/grey-16.png",
    "32": "icons/grey-32.png",
    "48": "icons/grey-48.png",
    "128": "icons/grey-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.dwalliance.com/*",
        "https://mingapothecary.com/*",
        "https://www.mingapothecary.com/*",
        "https://dwalliance.com/*",
        "https://www.dwalliance.com/*"
      ],
      "js": [
        "lib/util.js",
        "lib/providers/registry.js",
        "lib/providers/chatgpt.js",
        "lib/providers/gemini.js",
        "lib/providers/grok.js",
        "lib/providers/claude.js",
        "lib/status.js",
        "lib/md.js",
        "lib/pagefiles.js",
        "lib/chime.js",
        "content/panel.js",
        "content/dw.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "lib/util.js",
        "lib/interpreter.js",
        "lib/done.js",
        "lib/assets.js",
        "lib/runner.js",
        "lib/snapshot.js",
        "content/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content/ai-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
